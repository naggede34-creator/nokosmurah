# ============================================================
# WAJIB lewat env (dibutuhkan sebelum dashboard admin bisa dibuka)
# ============================================================
ADMIN_PASSWORD=ganti-ini
CRON_SECRET=isi-rahasia-panjang
# Database MongoDB (Atlas)
MONGODB_URI=
MONGODB_DB=artapedia

# ============================================================
# OPSIONAL: semua di bawah ini SEKARANG BISA diisi dari /admin > Integrasi (tanpa redeploy).
# Isian dashboard menang atas env; env hanya jadi cadangan / nilai awal.
# ============================================================
# Pakasir (deposit QRIS & Virtual Account, API v2)
PAKASIR_SLUG=
PAKASIR_KEY=
PAKASIR_BASE=https://app.pakasir.com
# SMP Payment (mesin deposit QRIS H2H DAN QRIS Gateway pengguna, saldo masuk lewat callback). URL callback: https://domainkamu.com/api/callbackqris/<SMP_SECRET>
SMP_QRIS=
SMP_SECRET=
SMP_USERNAME=
# AgenH2H (penarikan instan DANA): API Key + Secret dari Dashboard Akun AgenH2H > API. SKU DANA per nominal: "10000=SKU,20000=SKU" (lihat scripts/agen-sku.mjs)
# Webhook: tempel https://domainkamu.com/api/agenh2h/callback di Dashboard Akun AgenH2H > Webhook
AGEN_KEY=
AGEN_SECRET=
AGEN_DANA_SKUS=
# Telegram: notifikasi channel + backup otomatis ke chat PRIBADI owner (boleh lebih dari satu, pisahkan koma)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BACKUP_CHAT_ID=
# URL situs untuk link reset password, mis. https://domainkamu.com (kosong = otomatis dari request)
SITE_URL=
# Email reset password lewat Resend (resend.com). Tanpa ini admin tetap bisa buat link reset manual.
RESEND_API_KEY=
MAIL_FROM=Artapedia ID <noreply@domainkamu.com>

# Tombol sosial awal (setelah itu diatur di /admin/settings/buttons)
NEXT_PUBLIC_TG_URL=https://t.me/usernamekamu
NEXT_PUBLIC_WA_URL=https://wa.me/628xxxxxxxxxx

# Login Google & GitHub (juga bisa diisi dari /admin > Integrasi)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Mode CS 2: Nona Cantikan Customer Service (AI). Bisa juga diisi dari admin > Integrasi > Nona AI (Neoxr)
NEOXR_KEY=
# NEOXR_BASE=https://api.neoxr.eu/api/gpt4
